# Documentation only; make init generates ignored local configuration.
APP_ENV=dev
APP_DEBUG=0
APP_SECRET=replace-with-generated-local-secret
RUNTIME_PASSWORD=replace-with-generated-local-password
MIGRATION_PASSWORD=replace-with-generated-local-password
DATABASE_URL=postgresql://desk_runtime:replace-with-generated-local-password@db:5432/desk?serverVersion=18&charset=utf8
MIGRATION_DATABASE_URL=postgresql://desk_migrator:replace-with-generated-local-password@db:5432/desk?serverVersion=18&charset=utf8
ESD_PORT=8089
