#!/usr/bin/env python3
"""Generate local-only configuration without printing or overwriting secrets."""
import os
from pathlib import Path
import secrets

target = Path(__file__).resolve().parent.parent / ".env.local"
secret, runtime, migration = (secrets.token_hex(32) for _ in range(3))
content = (
    "APP_ENV=dev\nAPP_DEBUG=0\n"
    f"APP_SECRET={secret}\nRUNTIME_PASSWORD={runtime}\nMIGRATION_PASSWORD={migration}\n"
    f"DATABASE_URL=postgresql://desk_runtime:{runtime}@db:5432/desk?serverVersion=18&charset=utf8\n"
    f"MIGRATION_DATABASE_URL=postgresql://desk_migrator:{migration}@db:5432/desk?serverVersion=18&charset=utf8\n"
    "ESD_PORT=8089\n"
)
try:
    descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    if target.is_symlink() or not target.is_file() or target.stat().st_uid != os.getuid() or target.stat().st_mode & 0o077:
        raise SystemExit("Existing configuration must be a regular owner-only file; nothing changed.")
    print("Existing local configuration preserved.")
else:
    with os.fdopen(descriptor, "w") as stream:
        stream.write(content)
    print("Created protected local configuration; values not displayed.")
