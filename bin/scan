#!/usr/bin/env python3
"""Scan the public current tree and commit range without exposing ignored local data."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
image = "ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"


def git(*args):
    return subprocess.check_output(["git", "-C", str(root), *args])


paths = [os.fsdecode(value) for value in git("ls-files", "-z").split(b"\0") if value]
if not paths:
    raise SystemExit("No indexed public source to scan.")
with tempfile.TemporaryDirectory(prefix="esd-public-scan-") as temporary:
    export = Path(temporary)
    for name in paths:
        source = root / name
        if source.is_symlink():
            raise SystemExit("Review symlink scope before scanning.")
        if not source.exists():
            continue
        destination = export / name
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, destination)
    subprocess.run(["docker", "run", "--rm", "--network", "none", "-v", str(export) + ":/repo:ro,z", image,
                    "dir", "/repo", "--redact=100", "--no-banner", "--exit-code=1"], check=True)

base = os.environ.get("SCAN_BASE", "")
if base and set(base) != {"0"}:
    start = git("rev-parse", "--verify", base + "^{commit}").decode().strip()
else:
    candidate = subprocess.run(["git", "-C", str(root), "rev-parse", "--verify", "main^{commit}"], capture_output=True, text=True)
    start = candidate.stdout.strip() if candidate.returncode == 0 else ""
revision_range = start + "..HEAD" if start else "HEAD"
subprocess.run(["docker", "run", "--rm", "--network", "none", "-v", str(root) + ":/repo:ro,z", image,
                "git", "/repo", "--log-opts=" + revision_range, "--redact=100", "--no-banner", "--exit-code=1"], check=True)
print("PASS: redacted indexed-current-tree and commit-range scans.")
