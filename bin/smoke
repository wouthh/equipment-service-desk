#!/usr/bin/env python3
"""Smoke-test the locally built production image without credentials, DB or network."""
import subprocess
import os
import secrets

checks = [
    ["php", "-r", "if (PHP_MAJOR_VERSION !== 8 || PHP_MINOR_VERSION !== 4) { exit(1); }"],
    ["php", "-r", "require 'vendor/autoload.php'; if (class_exists('PHPUnit\\Framework\\TestCase')) { exit(1); }"],
    ["php-fpm", "-t"],
    ["sh", "-c", "test \"$(id -u)\" -ne 0 && test ! -f .env.local && test -f openapi/openapi.yaml"],
]
for check in checks:
    subprocess.run(["docker", "run", "--rm", "--network", "none", "--read-only", "--tmpfs", "/tmp",
                    "equipment-service-desk:local", *check], check=True)
environment = dict(os.environ, APP_SECRET=secrets.token_hex(32),
                   DATABASE_URL="postgresql://desk_runtime:" + secrets.token_hex(32) + "@db:5432/desk")
subprocess.run(["docker", "run", "--rm", "--network", "none", "--read-only",
                "--tmpfs", "/tmp", "--tmpfs", "/app/var:uid=1000,gid=1000,mode=0700",
                "-e", "APP_SECRET", "-e", "DATABASE_URL", "equipment-service-desk:local",
                "php", "bin/console", "about"], env=environment, check=True)
print("PASS: PHP 8.4, production kernel boot, no dev autoload, valid FPM, non-root and no local secret file.")
