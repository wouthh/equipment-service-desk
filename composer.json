{
  "name": "wouthh/equipment-service-desk",
  "description": "Synthetic equipment service requests with guarded transitions and asynchronous reports.",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.4.1 <8.5",
    "ext-ctype": "*", "ext-iconv": "*", "ext-pdo": "*", "ext-pdo_pgsql": "*",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "~3.6.0", "doctrine/dbal": "~4.4.0", "doctrine/migrations": "~3.9.0",
    "symfony/clock": "7.4.*", "symfony/console": "7.4.*", "symfony/dotenv": "7.4.*",
    "symfony/framework-bundle": "7.4.*", "symfony/security-bundle": "7.4.*",
    "symfony/validator": "7.4.*", "symfony/workflow": "7.4.*", "symfony/uid": "7.4.*",
    "symfony/messenger": "7.4.*", "symfony/doctrine-messenger": "7.4.*",
    "symfony/rate-limiter": "7.4.*", "symfony/lock": "7.4.*", "symfony/yaml": "7.4.*",
    "symfony/monolog-bundle": "^3.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0", "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-doctrine": "^2.0", "phpstan/phpstan-symfony": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.95",
    "symfony/browser-kit": "7.4.*", "symfony/css-selector": "7.4.*",
    "symfony/psr-http-message-bridge": "7.4.*",
    "nyholm/psr7": "^1.8", "league/openapi-psr7-validator": "^0.22"
  },
  "autoload": {"psr-4": {"App\\": "src/", "DoctrineMigrations\\": "migrations/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {"sort-packages": true, "allow-plugins": {}, "audit": {"abandoned": "fail"}},
  "conflict": {
    "symfony/cache": ">=8", "symfony/doctrine-bridge": ">=8",
    "symfony/error-handler": ">=8", "symfony/event-dispatcher": ">=8",
    "symfony/filesystem": ">=8", "symfony/finder": ">=8",
    "symfony/http-foundation": ">=8", "symfony/options-resolver": ">=8",
    "symfony/password-hasher": ">=8", "symfony/property-access": ">=8",
    "symfony/property-info": ">=8", "symfony/routing": ">=8",
    "symfony/security-core": ">=8", "symfony/security-csrf": ">=8",
    "symfony/security-http": ">=8", "symfony/stopwatch": ">=8",
    "symfony/string": ">=8", "symfony/type-info": ">=8",
    "symfony/var-dumper": ">=8", "symfony/var-exporter": ">=8",
    "symfony/dom-crawler": ">=8", "symfony/process": ">=8"
  },
  "minimum-stability": "stable", "prefer-stable": true
}
